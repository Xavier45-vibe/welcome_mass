# Copy to .env.local and fill in values for your environment.
# Production sessions require a unique, random secret.
AUTH_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:3000
# Required in production; the Neon integration provides this connection string.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Configure these to send password-reset emails through your SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
